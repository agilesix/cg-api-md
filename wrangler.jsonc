{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "md-commongrants-api",
  "main": "src/index.ts",
  // Latest stable compatibility date at time of scaffolding. See:
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-03-20",
  "compatibility_flags": ["nodejs_compat"],
  // Naming convention: {state}-grants-{purpose}. Encodes state + data domain +
  // purpose, avoids collisions with other D1/R2 resources in the same CF
  // account when this template is forked for other states (e.g. pa-grants-*).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "md-grants-commongrants",
      // Create with `pnpm run bootstrap` (or `wrangler d1 create
      // md-grants-commongrants`) and paste the returned uuid here.
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "src/storage/sql/migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "SNAPSHOTS",
      "bucket_name": "md-grants-raw-snapshots",
    },
  ],
  "triggers": {
    // Sync every 8 hours. Inherited from the sibling state APIs; revisit once
    // Maryland's actual refresh rate is known. Syncs are incremental
    // (watermark-based), so each run only fetches the changed delta.
    "crons": ["0 */8 * * *"],
  },
  "vars": {
    // TODO(md-source): Maryland's upstream API has not been identified yet, so
    // this base URL is an intentionally unresolvable RFC 2606 `.invalid` host —
    // a live sync fails loudly rather than silently hitting the wrong service.
    //
    // `MdSourceClient` currently builds CKAN `datastore_search` requests against
    // these two values (carried over from the template's reference adapter).
    // Replace both the values and the request shape once the real source is known.
    "MD_API_BASE_URL": "https://md-source.invalid/REPLACE-WITH-MD-SOURCE-API-BASE",
    "MD_RESOURCE_ID": "funding",
    "ENVIRONMENT": "production",
  },
  "observability": {
    "enabled": true,
  },

  // Preview environment — used by CI preview deploys (PRs).
  // D1 database is ephemeral: created per-PR by cd.yml, torn down on close.
  // The database_id is patched dynamically by the workflow before deploy.
  // R2 bucket is shared (snapshots are append-only / idempotent).
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "md-grants-preview",
          "database_id": "PATCHED_BY_CI",
          "migrations_dir": "src/storage/sql/migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "SNAPSHOTS",
          "bucket_name": "md-grants-raw-snapshots",
        },
      ],
      "vars": {
        "MD_API_BASE_URL": "https://md-source.invalid/REPLACE-WITH-MD-SOURCE-API-BASE",
        "MD_RESOURCE_ID": "funding",
        "ENVIRONMENT": "preview",
      },
    },
  },
}
